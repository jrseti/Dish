		(uuid "63886f85-7fd9-442e-bf9e-e239242821e5")
	)
	(text "\nPin	Caps under the 2 mm rule\nVCC (3)	C89 100 nF\nVIO (4)	C91 10 nF, C92 100 nF\nVISOIN (16)	C31 10 nF, C32 100 nF\nVISOOUT (19)	C29 100 nF\n"
		(exclude_from_sim no)
		(at 77.724 49.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "666b1412-4638-4c9e-b8af-6efb3d3ff1d2")
	)
	(text "BUS TERMINATION - fit BOTH shunts for an end-of-bus node.\nRemove BOTH for a mid-bus drop; never fit only one."
		(exclude_from_sim no)
		(at 179.832 183.642 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "77d39e2c-1003-4adc-80c6-7207c2ff8852")
	)
	(text "small switch\ninstead of jumpers"
		(exclude_from_sim no)
		(at 219.202 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7a82ff79-ed00-47cc-bc45-26a849de9c44")
	)
	(text "The purpose of this circuit:\n\n  1 - Provide CAN isolation between the STM32 CAN pins and the CAN bus\n  2 - CAN termination resistors"
		(exclude_from_sim no)
		(at 187.706 22.352 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "8c11b4b0-d8ba-46aa-8d7f-c7328b78f527")
	)
	(text "120Ω total"
		(exclude_from_sim no)
		(at 251.714 122.428 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a135c359-edab-430d-bad1-95b4454fd971")
	)
	(text "Ensure that GND_ISO (Pin 18) is connected \nby a trace to the other GND_ISO pin (Pin 20) \non the inside (device side) of the C88 100 nF \ncapacitor"
		(exclude_from_sim no)
		(at 124.206 49.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a9d3e7e4-7e53-4a74-b4f3-1a1ad74e28d4")
	)
	(text "Both ON or both OFF"
		(exclude_from_sim no)
		(at 218.948 139.446 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "bc49d897-6cbe-4cbc-9558-948010ce6faa")
	)
	(text "C93 provides noise immunity"
