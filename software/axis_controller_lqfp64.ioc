# ── PB3 : USART2_TX (RS-232 / GPS NMEA) ─────────────────────────────────────
# NOTE: PB3 was SWO in the original design. SWO is sacrificed here to provide
# USART2_TX for the RS-232 port. 2-wire SWD (PA13/PA14) is retained.
PB3.Locked=true
PB3.Mode=Asynchronous
PB3.Signal=USART2_TX

# ── PB4 : USART2_RX (RS-232 / GPS NMEA) ─────────────────────────────────────
PB4.Locked=true
PB4.Mode=Asynchronous
