# ── Virtual pins ─────────────────────────────────────────────────────────────
VP_SYS_VS_DBSignals.Mode=DisableDeadBatterySignals
VP_SYS_VS_DBSignals.Signal=SYS_VS_DBSignals
VP_SYS_VS_Systick.Mode=SysTick
VP_SYS_VS_Systick.Signal=SYS_VS_Systick

# ── I2C3 ─────────────────────────────────────────────────────────────────────
# Timing for 400 kHz Fast Mode at 170 MHz PCLK — regenerate in CubeMX after opening
I2C3.IPParameters=Timing
I2C3.Timing=0x00B03FDB

# ── SPI2 — W25Q32 ─────────────────────────────────────────────────────────────
# Mode 0 (CPOL=0, CPHA=0), 8-bit, MSB first, software NSS
# Prescaler /8 → ~21 MHz at 170 MHz PCLK1 (W25Q32 max 104 MHz)
SPI2.BaudRatePrescaler=SPI_BAUDRATEPRESCALER_8
SPI2.CLKPhase=SPI_PHASE_1EDGE
SPI2.CLKPolarity=SPI_POLARITY_LOW
SPI2.DataSize=SPI_DATASIZE_8BIT
SPI2.Direction=SPI_DIRECTION_2LINES
SPI2.FirstBit=SPI_FIRSTBIT_MSB
SPI2.IPParameters=VirtualMode-Full_Duplex_Master,BaudRatePrescaler,CLKPhase,CLKPolarity,DataSize,Direction,FirstBit,NSS
SPI2.NSS=SPI_NSS_SOFT
SPI2.VirtualMode-Full_Duplex_Master=VM_MASTER

