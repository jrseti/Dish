# ── PF0 : HSE OSC_IN (16 MHz crystal) ────────────────────────────────────────
PF0-OSC_IN.Locked=true
PF0-OSC_IN.Mode=HSE-External-Oscillator
PF0-OSC_IN.Signal=RCC_OSC_IN

# ── PF1 : HSE OSC_OUT ────────────────────────────────────────────────────────
PF1-OSC_OUT.Locked=true
PF1-OSC_OUT.Mode=HSE-External-Oscillator
PF1-OSC_OUT.Signal=RCC_OSC_OUT

# ── NRST ─────────────────────────────────────────────────────────────────────
PG10-NRST.Signal=SYS_RESET

# ── Virtual pins ─────────────────────────────────────────────────────────────
VP_SYS_VS_DBSignals.Mode=DisableDeadBatterySignals
VP_SYS_VS_DBSignals.Signal=SYS_VS_DBSignals
VP_SYS_VS_Systick.Mode=SysTick
VP_SYS_VS_Systick.Signal=SYS_VS_Systick

# ── I2C3 ─────────────────────────────────────────────────────────────────────
# Timing value 0x00B03FDB is calculated for 170 MHz PCLK, 400 kHz Fast Mode
# Verify/regenerate in CubeMX clock tree after opening
I2C3.IPParameters=Timing
I2C3.Timing=0x00B03FDB

# ── SPI2 — W25Q32 flash ───────────────────────────────────────────────────────
# Mode 0 (CPOL=0, CPHA=0), 8-bit, MSB first
# Prescaler /8 = ~21 MHz at 170 MHz PCLK1 — within W25Q32 104 MHz max
SPI2.BaudRatePrescaler=SPI_BAUDRATEPRESCALER_8
SPI2.CLKPhase=SPI_PHASE_1EDGE
SPI2.CLKPolarity=SPI_POLARITY_LOW
SPI2.DataSize=SPI_DATASIZE_8BIT
SPI2.Direction=SPI_DIRECTION_2LINES
SPI2.FirstBit=SPI_FIRSTBIT_MSB
SPI2.IPParameters=VirtualMode-Full_Duplex_Master,BaudRatePrescaler,CLKPhase,CLKPolarity,DataSize,Direction,FirstBit,NSS
SPI2.NSS=SPI_NSS_SOFT
SPI2.VirtualMode-Full_Duplex_Master=VM_MASTER

# ── TIM2 — Quadrature encoder ────────────────────────────────────────────────
SH.S_TIM2_CH1.0=TIM2_CH1,Encoder_Interface
SH.S_TIM2_CH1.ConfNb=1
SH.S_TIM2_CH2.0=TIM2_CH2,Encoder_Interface
SH.S_TIM2_CH2.ConfNb=1

# ── TIM3 — Step pulse PWM ────────────────────────────────────────────────────
TIM3.Channel-PWM\ Generation3\ CH3=TIM_CHANNEL_3
TIM3.IPParameters=Channel-PWM Generation3 CH3
SH.S_TIM3_CH3.0=TIM3_CH3,PWM Generation3 CH3
SH.S_TIM3_CH3.ConfNb=1

