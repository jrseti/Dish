	(text "USB 3.0 - 2 Ports"
		(exclude_from_sim no)
		(at 60 14 0)
		(effects
			(font
				(size 5 5)
			)
			(justify left top)
		)
		(uuid "1631eb4d-0043-44d5-a4b7-8b1965a7058d")
	)
	(text "U2 = port 0, U3 = port 1. Flow-through clamps: each line enters on\nthe left pin and leaves on the right pin of the same name. Place at USB1.\nThe CM5 has its own USB 3.0 controllers: the pairs come straight from\nthe module (pins 128-142 and 157-171). TX is AC-coupled on the module\n(CM5 datasheet Table 4), so there are no coupling caps here. RX is\nAC-coupled in the attached device.\nRoute every pair as 90 Ω differential, P/N matched within 0.1 mm. P/N of\na SuperSpeed pair may be swapped; D+/D- may not (CM5 datasheet 2.4)."
		(exclude_from_sim no)
		(at 22.86 81.28 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "5214b2d8-66cf-4124-b329-40670819a45d")
	)
	(text "USB 2.0 ESD (USB-A D+/D- and USB-C)"
		(exclude_from_sim no)
		(at 21.82 105.64 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "6f819e5e-9da0-4515-96ba-6d8579171b74")
	)
	(text "Stacked USB 3.0 Type-A connectors"
		(exclude_from_sim no)
		(at 143.74 26.9 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "b1d26e51-4d1b-4b50-bcd6-3c3f30ff87db")
	)
	(text "U6 AP22653 supplies and protects the 5 V to both\nUSB-A ports. EN is VBUS_EN from the CM5 (pin 111,\nactive high); R7 holds it off while the CM5 is\nunpowered or booting.\nR9 15k sets the limit to about 1.75 A, shared by\nthe two ports (USB 3.0 allows 0.9 A per port).\nFAULT is open-drain, pulled up by R8 to 3V3_CM5,\nread by the CM5 on GPIO25 (low = over-current).\nC7-C12: VBUS hold-up capacitance. D1 clamps VBUS."
		(exclude_from_sim no)
		(at 220.98 137.16 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "c1b95595-1cb5-41de-8707-95f6ce106ae9")
	)
	(text "C6: return path between the 5 V and ground planes for the USB3_1\npairs. Place it at the vias where they change layer (near U3)."
		(exclude_from_sim no)
		(at 143.74 155.2 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "d4a64625-9543-4293-8501-6a9ccf37c226")
	)
	(text "USB 3.0 SuperSpeed ESD"
		(exclude_from_sim no)
		(at 21.82 26.9 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "e04a8d65-dfd3-4a3c-b075-380a4660bd2e")
	)
	(text "USB1: Molex 48406-0003 (LCSC C565298), 2 x USB 3.0 Type-A, stacked.\nPins 1-9 = one port (CM5 USB3-0), pins 10-18 = the other (CM5 USB3-1).\nSSTX = host transmit (CM5 TX), SSRX = host receive (CM5 RX).\nShell to CHASSIS, bled to GND by R1/C1 on the top sheet."
		(exclude_from_sim no)
		(at 147.32 86.36 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "e43938eb-d0ba-4012-a72c-e3c374cfedd8")
	)
	(text "U4: USB 2.0 pairs of the two USB-A ports.\nU5: CM5 USB 2.0 port (pins 103/105) to the\nUSB-C rpiboot connector on the usb2 sheet."
		(exclude_from_sim no)
		(at 88.138 130.302 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "ebef72be-2719-4ad0-bc98-efdba8ed271b")
	)
	(text "Current-limited high-side switch"
		(exclude_from_sim no)
		(at 143.74 105.64 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "f78ce67e-5d19-4618-9133-14363d19579b")
	)
