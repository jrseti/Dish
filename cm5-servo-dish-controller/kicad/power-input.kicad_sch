	(text "F2 FUSE - BUY SEPARATELY (the assembler fits only the holder):\nLittelfuse 021806.3MXP: 5x20 mm glass, T6.3A 250 V, time-lag\nLCSC C142706; DigiKey / Mouser / Farnell: 021806.3MXP\nEquivalents: Bel Fuse 5ST 6.3-R, Eaton Bussmann S506-6.3-R\nTime-lag (T) only, never above 6.3 A (holder limit). Keep spares."
		(exclude_from_sim no)
		(at 55.88 84.455 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "cfa1ac76-d5a2-4100-a7c9-13a8c35b1fd8")
	)
