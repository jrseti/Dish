	(text "USB-C Port for CM5 Flashing (rpiboot)"
		(exclude_from_sim no)
		(at 26.924 26.162 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "68c7c52e-ceed-4cbc-992f-7871bf81c0b6")
	)
	(text "USB-C carries the CM5 USB 2.0 port (module pins 103/105). It is a device\nport for rpiboot (eMMC flashing) only. There is no mux: on the CM5 the two\nUSB-A ports have their own USB 3.0 controllers.\nUSB_OTG_ID (module pin 101) is left open = device role.\nUSBC1 VBUS is not used (the board takes no power from USB-C).\nD7 SMF6.0A clamps it; TP30 is there to probe it.\nNo USB-PD controller; CC has 5.1 kΩ Rd only.\nFlashing: fit the nRPIBOOT jumper (J5 1-2), power the board,\nconnect USB-C to the PC and run rpiboot."
		(exclude_from_sim no)
		(at 27.178 89.916 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cda4c191-7b8e-42e4-b048-76bd50fd5e9d")
	)
