		(uuid "5720ef05-0762-453f-ac12-a7a0b4ad2a04")
	)
	(text "Place D42 close\nto IN_SYS"
		(exclude_from_sim no)
		(at 116.84 114.554 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ce1113f7-93c3-4403-a766-4726f018fbdb")
	)
	(text "This circuit takes 12V from the battery, VBAT.\nVBAT is reverse polarity protected with Q10.\nThe eFuse limits to 4.4A."
		(exclude_from_sim no)
		(at 35.56 151.638 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "ee047ce9-2d69-407b-9223-f20cdab7ae68")
	)
	(text "Q9 - Services the switch, turn 12V on/off\nQ10 - reverse VBAT polarity + reverse current blocking FET\nQ11 - fast gate pull-down for Q10"
		(exclude_from_sim no)
		(at 154.432 132.842 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f1fbf4ed-52d2-45ab-bb54-3a161935de46")
	)
	(text "Power Flags"
		(exclude_from_sim no)
		(at 237.49 55.245 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f7c752e3-ca41-46b2-b977-a0a01d4c7e1f")
	)
	(text "Q9 = P-FET high-side switch, 12 V logic rail.\nSW3 closed -> gate pulled to GND, VGS = -12 V,\nQ9 ON (LED5 lights).\nSW3 open -> R101 pulls gate to source,\nVGS = 0, Q9 OFF."
		(exclude_from_sim no)
		(at 163.83 67.056 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f89eb4de-a426-46f3-ad29-316c45504c76")
	)
