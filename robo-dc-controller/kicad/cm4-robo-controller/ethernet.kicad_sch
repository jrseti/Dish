	)
	(text "LPJG0926HENL, shielded, LEDs, PoE-capable (LCSC C22457393).\nEP0-EP3 come straight from the CM4 - the PHY is on the module, no external PHY.\nTD center taps (pins 4, 5) bypassed to GND by C17 100nF.\nVC1-VC4 (pins 11-14) are the cable-side PoE taps - unused, no PoE on this board.\nShield (pins 19, 20) tied to signal GND."
		(exclude_from_sim no)
		(at 46.99 120.142 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6884582b-7521-4b41-b069-32233a9b811e")
	)
	(text "RJ45 with integrated magnetics"
		(exclude_from_sim no)
		(at 65.532 39.624 0)
		(effects
			(font
				(size 2.032 2.032)
			)
		)
		(uuid "695a0353-7b33-4a33-ab36-250d1d02e917")
	)
	(text "Clamps all four pairs on the CM4 side of the magnetics. \nPlace both at RJ1."
		(exclude_from_sim no)
		(at 177.038 116.078 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8a6fe05b-dfc4-4222-baf4-50d57e9137dd")
	)
	(text "Route EP0-EP3 as 100R differential pairs, matched within 0.15mm.\nKeep the RJ1 chassis/shield area clear of the signal ground pour.\n"
		(exclude_from_sim no)
		(at 47.244 138.938 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a418a2b2-bb89-42f8-bb6c-6cd946be2a67")
	)
	(text "CM4 Ethernet_nLED pins are active-low 3.3V sinks, IOL 8mA @ VOL 0.4V.\nETH_LEDG = activity (green), ETH_LEDY = link speed (yellow).\nRJ1 pins 15/17 are the LED anodes.\n"
		(exclude_from_sim no)
		(at 47.244 132.842 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a749fce3-88a9-45e2-b1d4-7073dff64512")
	)
	(text "Gigabit Ethernet - CM4 MDI to RJ45"
