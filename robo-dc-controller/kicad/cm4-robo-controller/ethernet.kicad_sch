	(text "Ethernet ESD"
		(exclude_from_sim no)
		(at 167.386 39.878 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "1ec0c020-9baa-4e45-95d9-e6e11a994516")
	)
	(text "HR911130A, shielded, integrated magnetics and LEDs, 100/1000Base-T (LCSC C54408).\nEP0-EP3 come straight from the CM4 - the PHY is on the module, no external PHY.\nChip-side center taps (P1) bypassed to GND by C17 100nF.\nBob Smith termination (4x75R + 1000pF/2kV) is built into the jack; P10 is that node, tied to GND.\nShield pins tied to signal GND."
		(exclude_from_sim no)
		(at 43.688 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6884582b-7521-4b41-b069-32233a9b811e")
	)
	(text "RJ45 with integrated magnetics"
		(exclude_from_sim no)
		(at 63.5 32.512 0)
		(effects
			(font
				(size 2.032 2.032)
			)
		)
		(uuid "695a0353-7b33-4a33-ab36-250d1d02e917")
	)
	(text "Clamps all four pairs on the CM4 side of the magnetics. \nPlace both at RJ1."
		(exclude_from_sim no)
		(at 177.038 116.078 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8a6fe05b-dfc4-4222-baf4-50d57e9137dd")
	)
	(text "Route EP0-EP3 as 100R differential pairs, matched within 0.15mm.\nKeep the RJ1 chassis/shield area clear of the signal ground pour.\n"
		(exclude_from_sim no)
		(at 43.942 161.036 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a418a2b2-bb89-42f8-bb6c-6cd946be2a67")
	)
	(text "CM4 Ethernet_nLED pins are active-low 3.3V sinks, IOL 8mA @ VOL 0.4V.\nETH_LEDG = activity (green, RJ1 pin 11 anode / 12 cathode).\nETH_LEDY = link speed (yellow, pin 14 anode / 13 cathode).\nR16/R17 220R gives ~4.5mA through the LED. That is below the 8mA limit.\n"
		(exclude_from_sim no)
		(at 43.942 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a749fce3-88a9-45e2-b1d4-7073dff64512")
	)
	(text "Gigabit Ethernet - CM4 MDI to RJ45"
		(exclude_from_sim no)
		(at 87.376 19.05 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "b388551c-0986-4781-b7f2-dffa89ca2652")
	)
