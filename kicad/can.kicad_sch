	(text "CAN Termination Resistors Jumpers"
		(exclude_from_sim no)
		(at 229.87 119.634 0)
		(effects
			(font
				(size 2.032 2.032)
			)
		)
		(uuid "169cc147-0419-4af1-9361-18765455e568")
	)
	(text "R104 51k sets I_OL = 0.87 A typ (0.78-0.96 A over\nthe +/-10 % spec). The eFuse REGULATES at I_OL.\nPGTH to GND holds PGOOD low, disabling the\n1.5x I_OL pulse allowance, so the 22 AWG CAT6\npair (0.92 A) is never exceeded.\nUVLO to GND = internal 15.4/14.6 V lockout.\nMODE to GND enables ILIM open/short detect.\nC96 100nF on dVdT = ~50 ms ramp, ~0.11 A inrush\ninto C95. SHDN floats high = enabled. \nR101/R102 halve Q9 gate drive to\n-12 V: DMP6023LE VGS limit is +/-20 V.\nLED5 lights when SW3 is on = bus powered."
		(exclude_from_sim no)
		(at 68.072 180.594 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "19200685-1c9d-405a-95c4-89fece7f076f")
	)
	(text "CAN_RX and CAN_TX come from the STM32"
		(exclude_from_sim no)
		(at 45.72 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3cc601a4-2972-43e1-a478-2fa4f6a582a7")
	)
	(text "This limits the current to 0.87A.\nThis limit prevents a short on the CAN bus\nfrom passing too much current over CAN_V+ and\nruining the wires. \nA CAT6 22AWG can carry ~0.9A - 3A or more\ndepending on conditions."
		(exclude_from_sim no)
		(at 26.162 90.424 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "457ca566-bb5c-45f7-811f-f7b2150f99ba")
	)
	(text "CAN 24V (CAN_V+) - Current limiting, On/OFF switch, Reverse polarity protection"
		(exclude_from_sim no)
		(at 24.384 31.75 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "5392b322-2cb2-4d31-aac2-44d06d6e3296")
	)
	(text "If using 24V CAN_V+ use CAT6 22AWG cable\nwhich is rated at 0.92A max.\nPlace D43 close to pin 8.\n"
		(exclude_from_sim no)
		(at 209.042 108.712 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "63886f85-7fd9-442e-bf9e-e239242821e5")
	)
	(text "\nPin	Caps under the 2 mm rule\nVCC (3)	C89 100 nF\nVIO (4)	C91 10 nF, C92 100 nF\nVISOIN (16)	C31 10 nF, C32 100 nF\nVISOOUT (19)	C29 100 nF\n"
		(exclude_from_sim no)
		(at 67.564 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "666b1412-4638-4c9e-b8af-6efb3d3ff1d2")
	)
