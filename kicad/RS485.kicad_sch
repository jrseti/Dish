	(text "Following the layout from the ISOW1432 EVM User's Guide\nThe datasheet differs from the EVM, so followed EVM layout\nCapacitors are the same as the EVM BOM\nFrom the datasheet:\n    \"GND2 and GISOIN need be shorted direclty on PCB, or connected through a ferrite bead.\""
		(exclude_from_sim no)
		(at 99.822 86.868 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b17c1054-f13b-4659-a5e9-682ca79c39cd")
	)
	(text "RS485_x_CHASSIS connects directly to chassis"
		(exclude_from_sim no)
		(at 148.844 120.904 0)
		(effects
			(font
				(size 0.762 0.762)
			)
		)
		(uuid "c3dbe5f3-1098-49bb-9aac-6466be77329f")
	)
	(text "L1/L2/L3/L4 are 205mΩ 330Ω@100MHz 700mA ±25% 0402 Ferrite Beads \nDatasheet: Isolated power converter output voltage. VISOOUT and VISOIN need \n           be shorted directly on PCB, or onnected through a ferrite bead.\n"
		(exclude_from_sim no)
		(at 100.33 101.346 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e2f6b34c-6065-45f1-932e-d410319999f8")
	)
	(text "There is one RS485 interfaces. \n\nThe MCU is an RS485 lead, able to send commands \nto other followers such as a servo driver."
		(exclude_from_sim no)
		(at 67.31 175.006 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "f09f7876-96ca-4994-bd6a-66dc3bd33636")
	)
	(text "HF Noise Bleed"
		(exclude_from_sim no)
		(at 124.714 120.904 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fae451fb-8989-480d-a901-46b671412c21")
	)
	(text "RS485"
		(exclude_from_sim no)
		(at 33.02 23.876 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "ffbea4ca-2ed8-43f7-88c0-6624d903a74a")
	)
